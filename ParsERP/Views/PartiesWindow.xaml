<UserControl x:Class="ParsERP.Views.PartiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="دفترچه تماس — تأمین‌کننده و مشتری" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBox x:Name="txtFilter" Width="220" Height="32" Margin="16,0,0,0" DockPanel.Dock="Left"
                     VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtFilter_TextChanged"
                     ToolTip="جستجوی نام، موبایل، کد..."/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="نوع" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbType" Height="32">
                        <ComboBoxItem Content="تأمین‌کننده" IsSelected="True"/>
                        <ComboBoxItem Content="مشتری"/>
                        <ComboBoxItem Content="هردو"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="نام" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtName" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="کد" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCode" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="موبایل اصلی" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtMobile" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="آدرس اصلی" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAddress" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <Button Grid.Column="5" Content="ذخیره" Style="{StaticResource PrimaryButtonStyle}"
                        Height="32" VerticalAlignment="Bottom" Padding="14,0" Click="BtnSave_Click"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,8,0">
                    <TextBlock Text="شماره تماس اضافه (برچسب|شماره)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtExtraPhone" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                             ToolTip="مثال: دفتر|02144556677"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,8,8,0">
                    <TextBlock Text="عرض/طول جغرافیایی (اختیاری)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtLat" Width="100" Height="32" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBox x:Name="txtLng" Width="100" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,8,0,0" Orientation="Horizontal">
                    <Button Content="پیامک" Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnSms_Click"/>
                    <Button Content="تماس" Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnCall_Click"/>
                    <Button Content="نقشه گوگل" Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnGoogle_Click"/>
                    <Button Content="نشان" Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnNeshan_Click"/>
                    <Button Content="بلد" Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnBalad_Click"/>
                    <Button Content="واتساپ" Height="30" Padding="12,0" Click="BtnWhatsApp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgParties" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                      HeadersVisibility="Column" BorderThickness="0" SelectionChanged="DgParties_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="نوع" Binding="{Binding PartyTypeFa}" Width="100"/>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="70"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding NameFa}" Width="*"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="120"/>
                    <DataGridTextColumn Header="آدرس" Binding="{Binding PrimaryAddress}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="0,8,0,0" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
    </Grid>
</UserControl>
