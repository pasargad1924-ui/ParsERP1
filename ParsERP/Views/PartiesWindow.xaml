<Window x:Class="ParsERP.Views.PartiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اشخاص — تأمین‌کننده و مشتری"
        Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="تأمین‌کننده و مشتری" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="نوع" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbType" Height="32">
                        <ComboBoxItem Content="Supplier" IsSelected="True"/>
                        <ComboBoxItem Content="Customer"/>
                        <ComboBoxItem Content="Both"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="نام" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtName" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="کد" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtCode" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="موبایل" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtMobile" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <Button Grid.Column="4" Content="ذخیره" Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="0,18,0,0" Padding="14,0" Click="BtnSave_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgParties" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                      HeadersVisibility="Column" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="نوع" Binding="{Binding PartyType}" Width="90"/>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding NameFa}" Width="*"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</Window>
