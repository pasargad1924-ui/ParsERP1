<Window x:Class="ParsERP.Views.SerialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت سریال‌ها"
        Height="640" Width="960"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان -->
        <TextBlock Grid.Row="0" Text="تولید و مدیریت سریال ۱۰ رقمی"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16"/>

        <!-- فرم تولید -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="کد نوع محصول (۲ رقم)" FontSize="12" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtProductType" Height="36" MaxLength="2"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="سال شمسی (دو رقم آخر)" FontSize="12" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtSolarYear" Height="36" MaxLength="2"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="شماره شروع سری (۵ رقم)" FontSize="12" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtStartNumber" Height="36" MaxLength="5"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="تعداد سریال" FontSize="12" Margin="0,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtCount" Height="36"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <Button Grid.Column="4" Content="تولید سریال"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Bottom" Height="36" Padding="20,0"
                        Click="BtnGenerate_Click"/>
            </Grid>
        </Border>

        <!-- جدول نتایج -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgSerials"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CanUserAddRows="False"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="سریال" Binding="{Binding SerialNo}" Width="140"/>
                    <DataGridTextColumn Header="نوع محصول" Binding="{Binding ProductTypeCode}" Width="100"/>
                    <DataGridTextColumn Header="سال" Binding="{Binding SolarYear}" Width="80"/>
                    <DataGridTextColumn Header="شماره سری" Binding="{Binding SerialNumber}" Width="100"/>
                    <DataGridTextColumn Header="رقم کنترل" Binding="{Binding CheckDigit}" Width="90"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ورود دستی + دکمه‌ها -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBox x:Name="txtManualSerial" Width="180" Height="36"
                     VerticalContentAlignment="Center" Padding="8,0"
                     MaxLength="10" ToolTip="ورود دستی سریال ۱۰ رقمی"/>
            <Button Content="ثبت دستی" Style="{StaticResource PrimaryButtonStyle}"
                    Height="36" Margin="8,0,0,0" Padding="16,0"
                    Click="BtnManual_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center"
                       Margin="20,0,0,0" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
