<UserControl x:Class="ParsERP.Views.PurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="سفارش خرید" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Margin="0,28,0,8" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="راهنما: تأمین‌کننده و کالا را انتخاب کنید. با تیک «رسید به انبار» موجودی همان لحظه افزایش می‌یابد."/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,4,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="تأمین‌کننده" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbSupplier" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="انبار دریافت" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbWarehouse" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="یادداشت" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtNotes" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="کالا" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbProduct" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="تعداد" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtQty" Text="1" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="قیمت واحد" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtPrice" Text="0" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <Button Grid.Column="3" Content="افزودن ردیف" Margin="0,18,0,0" Padding="12,0" Click="BtnAddLine_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgLines" AutoGenerateColumns="False" CanUserResizeColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding ProductCode}"/>
                    <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}"/>
                    <DataGridTextColumn Header="تعداد" Binding="{Binding Qty}"/>
                    <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice}"/>
                    <DataGridTextColumn Header="جمع" Binding="{Binding LineTotal}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="chkReceive" Content="رسید خودکار به انبار" IsChecked="True" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Left" Content="ثبت سفارش خرید" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" Padding="16,0" Click="BtnSave_Click"/>
            <Button DockPanel.Dock="Left" Content="پاک کردن ردیف‌ها" Margin="8,0,0,0" Padding="12,0" Click="BtnClear_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>
    </Grid>
</UserControl>
