<UserControl x:Class="ParsERP.Views.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft" FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="فروش" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Margin="0,28,0,8" FontWeight="SemiBold" Text="مشتری + کالا + قیمت. تیک خروج از انبار موجودی را کم می‌کند و سریال را Sold می‌کند."/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,4,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="مشتری" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbCustomer" Height="32" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="انبار خروج" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbWarehouse" Height="32" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="یادداشت / ارسال" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNotes" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="کالا" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbProduct" Height="32" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="تعداد" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtQty" Height="32" Text="1" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="قیمت" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPrice" Height="32" Text="0" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="سریال (اختیاری)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSerial" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <Button Grid.Column="4" Content="افزودن" Height="32" Margin="0,18,0,0" Padding="12,0" Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgLines" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کالا" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="تعداد" Binding="{Binding Qty}" Width="70"/>
                    <DataGridTextColumn Header="قیمت" Binding="{Binding Price}" Width="90"/>
                    <DataGridTextColumn Header="سریال" Binding="{Binding Serial}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <CheckBox x:Name="chkStock" Content="خروج از انبار" IsChecked="True" VerticalAlignment="Center"/>
            <Button Content="ثبت فروش" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="12,0,0,0" Padding="16,0" Click="BtnSave_Click"/>
            <TextBlock x:Name="txtStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</UserControl>
