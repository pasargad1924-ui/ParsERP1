<Window x:Class="ParsERP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به پارس‌ئی‌آرپی | نسخه 1.1.0"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0">
                <Grid>
                    <!-- دکمه‌های پنجره (سمت چپ در RTL = ظاهراً گوشه) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0">
                        <Button x:Name="btnClose" Content="✕" Width="32" Height="28" FontSize="12"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                ToolTip="خروج" Cursor="Hand" Click="BtnClose_Click"/>
                        <Button x:Name="btnMinimize" Content="—" Width="32" Height="28" FontSize="14"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                ToolTip="کوچک کردن به نوار وظیفه" Cursor="Hand" Click="BtnMinimize_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="پارس‌ئی‌آرپی" FontSize="28" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="سیستم مدیریت یکپارچه تولید و پروژه"
                                   FontSize="13" Foreground="#E0F2F1"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="40,30,40,10">
                <TextBlock Text="نام کاربری" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Height="42" FontSize="14"
                         VerticalContentAlignment="Center" Padding="12,0"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"/>

                <TextBlock Text="رمز عبور" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <PasswordBox x:Name="txtPassword" Height="42" FontSize="14"
                             VerticalContentAlignment="Center" Padding="12,0"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"/>

                <TextBlock x:Name="txtError" Text="" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                <Button x:Name="btnLogin" Content="ورود به سیستم"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44" Margin="0,24,0,0" Click="BtnLogin_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="نسخه 1.1.0 | پارس‌ئی‌آرپی"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
        </Grid>
    </Border>
</Window>
