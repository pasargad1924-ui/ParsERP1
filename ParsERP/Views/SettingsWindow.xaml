<Window x:Class="ParsERP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات"
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="تنظیمات مسیرها و برنامه" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="مسیر فایل دیتابیس" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtDbPath" Height="36" VerticalContentAlignment="Center" Padding="10,0"/>
                <Button Grid.Column="1" Content="انتخاب..." Height="36" Margin="8,0,0,0" Padding="14,0"
                        Click="BtnBrowseDb_Click"/>
            </Grid>

            <TextBlock Text="مسیر پوشه پشتیبان‌گیری" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBackupPath" Height="36" VerticalContentAlignment="Center" Padding="10,0"/>
                <Button Grid.Column="1" Content="انتخاب..." Height="36" Margin="8,0,0,0" Padding="14,0"
                        Click="BtnBrowseBackup_Click"/>
            </Grid>

            <TextBlock Text="نام شرکت" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="txtCompany" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                     Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ذخیره تنظیمات" Style="{StaticResource PrimaryButtonStyle}"
                    Height="40" Padding="24,0" Click="BtnSave_Click"/>
            <Button Content="بستن" Height="40" Margin="12,0,0,0" Padding="20,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
