<UserControl x:Class="ParsERP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="تنظیمات مسیرها و برنامه" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="مسیر فایل دیتابیس" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtDbPath" VerticalContentAlignment="Center" Padding="10,0"/>
                <Button Grid.Column="1" Content="انتخاب..." Margin="8,0,0,0" Padding="14,0"
                        Click="BtnBrowseDb_Click"/>
            </Grid>

            <TextBlock Text="مسیر پوشه پشتیبان‌گیری" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBackupPath" VerticalContentAlignment="Center" Padding="10,0"/>
                <Button Grid.Column="1" Content="انتخاب..." Margin="8,0,0,0" Padding="14,0"
                        Click="BtnBrowseBackup_Click"/>
            </Grid>

            <TextBlock Text="نام شرکت" FontSize="13" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="txtCompany" VerticalContentAlignment="Center" Padding="10,0"
                     Margin="0,0,0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ذخیره تنظیمات" Style="{StaticResource PrimaryButtonStyle}" Padding="24,0" Click="BtnSave_Click"/>
            <Button Content="بستن" Margin="12,0,0,0" Padding="20,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
