<Window x:Class="ParsERP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پارس‌ئی‌آرپی | مدیریت یکپارچه | نسخه 0.7.0"
        Height="740" Width="1280"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- نوار منوی استاندارد -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,2">
            <MenuItem Header="فایل">
                <MenuItem Header="جدید" Click="MenuStub_Click"/>
                <MenuItem Header="باز کردن..." Click="MenuStub_Click"/>
                <MenuItem Header="ذخیره" Click="MenuStub_Click"/>
                <Separator/>
                <MenuItem Header="وارد کردن سریال از CSV..." Click="MenuImportSerial_Click"/>
                <MenuItem Header="صادر کردن سریال به CSV..." Click="MenuExportSerial_Click"/>
                <Separator/>
                <MenuItem Header="چاپ..." Click="MenuStub_Click"/>
                <MenuItem Header="تنظیمات چاپ..." Click="MenuStub_Click"/>
                <Separator/>
                <MenuItem Header="خروج" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="ویرایش">
                <MenuItem Header="کپی" InputGestureText="Ctrl+C" Click="MenuStub_Click"/>
                <MenuItem Header="برش" InputGestureText="Ctrl+X" Click="MenuStub_Click"/>
                <MenuItem Header="چسباندن" InputGestureText="Ctrl+V" Click="MenuStub_Click"/>
                <Separator/>
                <MenuItem Header="جستجو..." Click="MenuFocusSearch_Click"/>
            </MenuItem>
            <MenuItem Header="نمایش">
                <MenuItem Header="داشبورد" Click="MenuDashboard_Click"/>
                <MenuItem Header="بازنشانی نما" Click="MenuStub_Click"/>
            </MenuItem>
            <MenuItem Header="راهنما">
                <MenuItem Header="راهنمای استفاده" Click="MenuHelp_Click"/>
                <MenuItem Header="درباره نرم‌افزار" Click="MenuAbout_Click"/>
                <MenuItem Header="به‌روزرسانی" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- نوار ابزار / جستجو -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtPageTitle" Text="داشبورد" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="v0.7.0" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtGlobalSearch" Height="34" VerticalContentAlignment="Center"
                             Padding="10,0" ToolTip="جستجوی سریال، پارت، محصول..."
                             KeyDown="GlobalSearch_KeyDown"/>
                    <Button Grid.Column="1" Width="40" Height="34" Margin="6,0,0,0" Click="BtnSearch_Click"
                            ToolTip="جستجو" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0">
                        <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- منوی کناری -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="16,20">
                        <StackPanel>
                            <TextBlock Text="پارس‌ئی‌آرپی" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="مدیریت تولید و سریال" FontSize="12" Foreground="#E0F2F1"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer>
                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Text="اصلی" Margin="16,6,16,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuDashboard_Click">
                                <TextBlock Text="داشبورد"/>
                            </Button>
                            <TextBlock Text="تولید و انبار" Margin="16,12,16,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuProducts_Click">
                                <TextBlock Text="کالا و محصولات"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuParties_Click">
                                <TextBlock Text="اشخاص (تأمین/مشتری)"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuSerials_Click">
                                <TextBlock Text="سریال‌ها"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuStub_Click">
                                <TextBlock Text="سفارشات تولید"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuWarehouse_Click">
                                <TextBlock Text="انبار"/>
                            </Button>
                            <TextBlock Text="مالی و سیستم" Margin="16,12,16,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuSettings_Click">
                                <TextBlock Text="تنظیمات"/>
                            </Button>
                            <Button Style="{StaticResource MenuButtonStyle}" Click="MenuHelp_Click">
                                <TextBlock Text="راهنما و درباره"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20"/>
        </Grid>
    </DockPanel>
</Window>
