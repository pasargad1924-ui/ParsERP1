<Window x:Class="ParsERP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پارس‌ئی‌آرپی | مدیریت یکپارچه"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Vazirmatn"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>   <!-- منوی کناری -->
            <ColumnDefinition Width="*"/>     <!-- محتوای اصلی -->
        </Grid.ColumnDefinitions>

        <!-- ==================== منوی کناری راست‌چین ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- لوگو و نام نرم‌افزار -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,24">
                    <StackPanel>
                        <TextBlock Text="پارس‌ئی‌آرپی" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="مدیریت تولید و پروژه" 
                                   FontSize="12" Foreground="#CCFFFFFF" 
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- آیتم‌های منو -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">

                        <TextBlock Text="اصلی" Margin="20,8,20,4" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>

                        <!-- داشبورد -->
                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="داشبورد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="تولید و انبار" Margin="20,16,20,4" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Products" Click="MenuProducts_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="کالا و محصولات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Serials" Click="MenuSerials_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔢" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="سریال‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Production">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏭" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="سفارشات تولید" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Warehouse">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏪" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="انبار" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Outsourcing">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤝" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="برون‌سپاری" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Warranty">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="گارانتی" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="مالی و سیستم" Margin="20,16,20,4" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Accounting">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="حسابداری" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Users">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="کاربران و دسترسی‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Tag="Settings" Click="MenuSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="تنظیمات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- اطلاعات کاربر در پایین منو -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" 
                                Background="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0">
                            <TextBlock Text="م" FontSize="14" FontWeight="Bold" 
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtCurrentUser" Text="مدیر سیستم" 
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="خروج" FontSize="11" 
                                       Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ==================== محتوای اصلی ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>  <!-- هدر -->
                <RowDefinition Height="*"/>   <!-- محتوا -->
            </Grid.RowDefinitions>

            <!-- هدر بالا -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="txtPageTitle" Text="داشبورد" 
                               FontSize="20" FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBox Width="260" Height="36" 
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FlowDirection="RightToLeft"
                                 ToolTip="جستجوی سریع در همه بخش‌ها..."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- فریم محتوا -->
            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>
