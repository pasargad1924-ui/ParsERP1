<UserControl x:Class="ParsERP.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="1" Margin="0,12,0,12">
            <TabItem Header="درباره نرم‌افزار">
                <StackPanel Margin="16">
                    <TextBlock x:Name="txtAboutTitle" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="سیستم مدیریت تولید، سریال، انبار، فروش و گارانتی" Margin="0,0,0,12"/>
                    <TextBlock x:Name="txtAboutVersion" Margin="0,0,0,8"/>
                    <TextBlock Text="رابط فارسی • راست‌چین • دیتابیس محلی SQLite" Margin="0,0,0,8"/>
                    <TextBlock Text="لاگ برنامه در پوشه LocalAppData\ParsERP\Logs ذخیره می‌شود." TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="راهنما">
                <ScrollViewer Margin="12">
                    <TextBlock x:Name="txtHelp" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="به‌روزرسانی">
                <StackPanel Margin="16">
                    <TextBlock Text="بررسی به‌روزرسانی" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtUpdateStatus" Text="نسخه فعلی نصب‌شده است. برای نسخه جدید از کانال انتشار یا گیت‌هاب استفاده کنید." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="باز کردن پوشه لاگ" Padding="16,0" HorizontalAlignment="Left" Click="BtnOpenLog_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="بستن" HorizontalAlignment="Left" Padding="24,0" Click="BtnClose_Click"/>
    </Grid>
</UserControl>
