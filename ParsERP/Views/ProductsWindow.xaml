<Window x:Class="ParsERP.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعریف محصولات"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="تعریف محصولات و کد نوع (۲ رقم برای سریال)" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="کد (۲ رقم)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCode" Height="34" MaxLength="2" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="نام فارسی" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNameFa" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="واحد" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtUnit" Height="34" Text="عدد" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="گارانتی (ماه)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtWarranty" Height="34" Text="12" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>
                <Button Grid.Column="4" Content="ذخیره محصول" Style="{StaticResource PrimaryButtonStyle}"
                        Height="34" VerticalAlignment="Bottom" Padding="16,0" Click="BtnSave_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="dgProducts" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" BorderThickness="0" Background="Transparent"
                      MouseDoubleClick="DgProducts_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="70"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding NameFa}" Width="*"/>
                    <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="80"/>
                    <DataGridCheckBoxColumn Header="سریال" Binding="{Binding HasSerial}" Width="70"/>
                    <DataGridCheckBoxColumn Header="گارانتی" Binding="{Binding HasWarranty}" Width="70"/>
                    <DataGridTextColumn Header="ماه گارانتی" Binding="{Binding WarrantyMonths}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="0,10,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
    </Grid>
</Window>
