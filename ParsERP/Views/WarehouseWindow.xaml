<Window x:Class="ParsERP.Views.WarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انبار و موجودی"
        Height="680" Width="960"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="انبار — موجودی، رسید، حواله، انتقال" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Margin="0,28,0,8" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="راهنما: رسید=ورود | حواله=خروج | انتقال=بین دو انبار | موجودی منفی مجاز نیست."/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,4,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="انبار مبدأ" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbWarehouse" Height="32" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="کالا" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbProduct" Height="32" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="تعداد" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="txtQty" Height="32" Text="1" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="انبار مقصد (انتقال)" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="cmbWarehouseTo" Height="32" DisplayMemberPath="NameFa"/>
                </StackPanel>
                <Button Grid.Column="4" Content="رسید" Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="0,18,4,0" Padding="12,0" Click="BtnIn_Click"/>
                <Button Grid.Column="5" Content="حواله" Height="32" Margin="0,18,4,0" Padding="12,0" Click="BtnOut_Click"/>
                <Button Grid.Column="6" Content="انتقال" Height="32" Margin="0,18,0,0" Padding="12,0" Click="BtnTransfer_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="موجودی">
                <DataGrid x:Name="dgStock" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="انبار" Binding="{Binding WarehouseName}" Width="140"/>
                        <DataGridTextColumn Header="کد" Binding="{Binding ProductCode}" Width="70"/>
                        <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="موجودی" Binding="{Binding Quantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="آخرین تراکنش‌ها">
                <DataGrid x:Name="dgTx" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="زمان" Binding="{Binding CreatedAt}" Width="140"/>
                        <DataGridTextColumn Header="نوع" Binding="{Binding TransType}" Width="100"/>
                        <DataGridTextColumn Header="انبار" Binding="{Binding WarehouseName}" Width="120"/>
                        <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="شرح" Binding="{Binding Notes}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="بازنشانی" Height="32" Padding="12,0" Click="BtnRefresh_Click"/>
            <Button Content="خروجی CSV موجودی" Height="32" Margin="8,0,0,0" Padding="12,0" Click="BtnExport_Click"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
